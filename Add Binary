class Add_Binary {
    public static void main(String[] args) {
        String a="11";
        String b="1";
        int carry=0;
        int sum=0;
        StringBuilder res=new StringBuilder();

        int i=a.length()-1;
        int j=b.length()-1;

        while(i>=0|| j>=0||carry==1){
            sum=carry;

            if(i>=0){
                sum+=a.charAt(i)-'0';
                i--;
            }

            if(j>=0){
                sum+=b.charAt(j)-'0';
                j--;
            }

            res.append(sum%2);
            carry=sum/2;
        }
        System.out.print(res.reverse().toString());
    }
}
