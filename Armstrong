public class Armstrong {
    public static void main(String[] args) {
        int n=54748;
        int digits=0;
        int new_n=n;
        while(n>0){
            n=n/10;
            digits++;
        }
        
        int armstrong=0;
        int armstrong_num=new_n;
        while(new_n>0){
            armstrong+=Math.pow(new_n%10,digits);
            new_n=new_n/10;
        }
        
        if(armstrong_num==armstrong){
            System.out.print("Armstrong");
        }
        else{
            System.out.println("Not an Armstrong");
        }
    }
}
