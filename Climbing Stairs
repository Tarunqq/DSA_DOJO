-----------------------Optimal(DP)------------------------------------------
class Solution {
    public int solve(int[] arr,int n){
        if(n==0)
            return 1;
        else if(n<0)
            return 0;

        if(arr[n]!=-1)
            return arr[n];
        else{
            arr[n]=solve(arr, n-1)+solve(arr, n-2);
            return arr[n];
        }
        
    }
    public int climbStairs(int n) {
        int[] arr=new int[n+1];

        for(int i=0;i<=n;i++){
            arr[i]=-1;
        }

        return solve(arr,n);
    }
}
