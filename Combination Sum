class Solution {
    public void solve(int i,List<Integer> curr, int sum,int[] arr,int target, List<List<Integer>> res){
        if(sum==target){
            res.add(new ArrayList<>(curr));
            return;
        }
        if(sum>target || i==arr.length)
            return;

        curr.add(arr[i]);
        solve(i,curr,sum+arr[i],arr, target, res);//take(include)
        curr.remove(curr.size()-1);
        solve(i+1,curr,sum,arr, target, res);//skip(not include)
    }
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res=new ArrayList<>();
        solve(0,new ArrayList<>(),0,candidates, target, res);
        return res;
    }
}
