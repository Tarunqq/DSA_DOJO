class Solution {
    public int maxArea(int[] height) {
        int left=0,right=height.length-1;
        int max=0;
        while(left<right){
            int length=right-left;
            int min=Math.min(height[left],height[right]);
            max=Math.max(max,length*min);

            if(height[left]>height[right])
                right--;
            else
                left++;
        }
        return max;
    }
}
