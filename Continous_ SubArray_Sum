class Solution {
    public boolean checkSubarraySum(int[] nums, int k) {
        HashMap <Integer, Integer> map=new HashMap<>();
        boolean res=false;
        int sum=0;

        map.put(sum,-1);
        for(int i=0;i<nums.length;i++){
            sum+=nums[i];

            int rem=sum%k;
            if(map.containsKey(rem)){
                if(i-map.get(rem)>=2)
                    return !res;
            }
            else
                map.put(rem,i);
        }
        return res;
    }
}
