class Main {
    public static void main(String[] args) {
        int[] arr={23,2,4,6,7};
        int k=6;
        boolean res=false;
        for(int i=0;i<arr.length;i++){
            int sum=0;
            for(int j=i;j<arr.length;j++){
                sum+=arr[j];
                if(sum%k==0 && j-i+1>=2){
                    res=true;
                    break;
                }
            }
        }
        System.out.print(res);
    }
}
