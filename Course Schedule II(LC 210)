class Solution {
    static class Edge{
        int src;
        int dest;
        Edge(int src,int dest){
            this.src=src;
            this.dest=dest;
        }
    }
    public void createGraph(ArrayList<Edge>[] graph,int[][] prerequisites){
        for(int i=0;i<graph.length;i++){
            graph[i]=new ArrayList<>();
        }

        for(int i=0;i<prerequisites.length;i++){
            graph[prerequisites[i][1]].add(new Edge(prerequisites[i][1],prerequisites[i][0]));
        }
    }
    public void TopoSortBFS(ArrayList<Edge>[] graph,int[] inOrdArr){
        for(int i=0;i<graph.length;i++){
            for(int j=0;j<graph[i].size();j++){
                Edge e=graph[i].get(j);
                inOrdArr[e.dest]++;
            }
        }
    }
    public int[] findOrder(int numCourses, int[][] prerequisites) {
        ArrayList<Edge>[] graph=new ArrayList[numCourses];
        createGraph(graph,prerequisites);
        int[] inOrdArr=new int[numCourses];
        TopoSortBFS(graph, inOrdArr);
        int[] res=new int[numCourses];
        Deque<Integer> Dq=new ArrayDeque<>();
        for(int i=0;i<inOrdArr.length;i++){
            if(inOrdArr[i]==0)
                Dq.offer(i);
        }
        int idx=0;
        while(!Dq.isEmpty()){
            int curr=Dq.poll();
            res[idx]=curr;
            idx++;

            for(int i=0;i<graph[curr].size();i++){
                Edge e=graph[curr].get(i);
                inOrdArr[e.dest]--;
                if(inOrdArr[e.dest]==0)
                    Dq.offer(e.dest);
            }
        }

        return (idx==numCourses)?res:new int[0];
    }
}
