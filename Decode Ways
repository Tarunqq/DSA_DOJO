class Solution {
    public int Solve(String s, int i){
        if(i>s.length())
            return 0;
        
        if(i==s.length())
            return 1;
        
        int num1=Integer.parseInt(s.substring(i,i+1));
        int count=0;
        if(num1>=1 && num1<=9){
            count+=Solve(s,i+1);
        }

        if(i+1<s.length()){
            int num2=Integer.parseInt(s.substring(i,i+2));
            if(num2>=10 && num2<=26){
                count+=Solve(s,i+2);
            }
        }
        return count;

    }
    public int numDecodings(String s) {
        return Solve(s,0);
    }
}
------------------------Optimal(DP)-------------------------------------------
class Solution {
    public int Solve(String s, int i,int[] dp){
        if(i>s.length())
            return 0;
        
        if(i==s.length())
            return 1;

        if(dp[i]!=-1)
            return dp[i];
        
        dp[i]=0;
        
        int num1=Integer.parseInt(s.substring(i,i+1));
        if(num1>=1 && num1<=9){
            dp[i]+=Solve(s,i+1,dp);
            
        }
        if(i+1<s.length()){
            int num2=Integer.parseInt(s.substring(i,i+2));
            if(num2>=10 && num2<=26){
                dp[i]+=Solve(s,i+2,dp);
            }
        }
        return dp[i];

    }
    public int numDecodings(String s) {
        int[] dp=new int[s.length()];
        for(int i=0;i<dp.length;i++){
            dp[i]=-1;
        }
        return Solve(s,0,dp);
    }
}
