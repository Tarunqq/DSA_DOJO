public class Decreasing_num_tri {
    public static void main(String[] args) {
        int n=5;
        boolean c=true;
            for(int i=n;i>=1;i--){
                int large=(i*(i+1))/2;
                int small=((i-1)*i)/2;
                if(c==true){
                    for(int j=large;j>=small+1;j--){
                        System.out.print(j+" ");
                    }
                    c=false;
                }
                else if(c==false){
                    for(int j=small+1;j<=large;j++){
                        System.out.print(j+" ");
                    }
                    c=true;
                }
                System.out.println();
            }
    }
}
