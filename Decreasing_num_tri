[Approach 2]

class Main {
    public static void main(String[] args) {
        int n=5;
        int num=(n*(n+1))/2;
        boolean b=true;

        for(int i=n;i>=1;i--){
            if(b==true){
                for(int j=1;j<=i;j++){
                    System.out.print(num-- +" ");
                }
                b=false;
                System.out.println();
            }
            else{
                int Start=num-i+1;
                for(int j=1;j<=i;j++){
                    System.out.print(Start+++" ");
                }
                num=num-i;
                b=true;
                System.out.println();
            }
            
        }
        
    }
}
