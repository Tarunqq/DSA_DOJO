class Solution {
    public int solve(String word1, String word2, int m,int n,int i, int j, int[][] memo){
        if(i==m)
            return n-j;

        if(j==n)
            return m-i;

        if(memo[i][j]!=-1){
            return memo[i][j];
        }
        
        if(word1.charAt(i)==word2.charAt(j)){
            memo[i][j]=solve(word1, word2,m,n,i+1,j+1,memo);
            return memo[i][j];
        }
        int insert=1+solve(word1,word2,m,n,i,j+1,memo);
        int delete=1+solve(word1,word2,m,n,i+1,j,memo);
        int replace=1+solve(word1,word2,m,n,i+1,j+1,memo);

        memo[i][j]=Math.min((Math.min(insert, delete)), replace);
        return memo[i][j];

    }
    public int minDistance(String word1, String word2) {
        int m=word1.length();
        int n=word2.length();
        int[][] memo=new int[m][n];
        for(int i=0;i<memo.length;i++){
            for(int j=0;j<memo[0].length;j++){
                memo[i][j]=-1;
            }
        }
        return solve(word1,word2,m,n,0,0,memo);
    }
}
