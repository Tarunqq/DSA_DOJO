----------------------------------------Brute-------------------------------
class Solution {
    public int fib(int n) {
        if(n==0 || n==1)
            return n;
        return fib(n-1)+fib(n-2);
    }
}

--------------------Optimal(DP)-----------------------------------------------
class Solution {
    public int fib(int n) {
        int[] arr=new int[n+1];

        if(n==0 || n==1)
            return n;

        for(int i=0;i<=n;i++){
            arr[i]=-1;
        }

        arr[0]=0;
        arr[1]=1;

        return solve(arr, n);
    }

    public int solve(int[] arr, int n){
        if(arr[n]!=-1)
            return arr[n];
        else
            return solve(arr, n-1) + solve(arr, n-2);
    }
}
