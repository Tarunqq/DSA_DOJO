class Find {
    public static void main(String[] args) {
        int target=63;
        int matrix[][]={
            {1,3,5,7},
            {10,11,16,20},
            {23,30,34,60}
        };
        int arr[]=new int[matrix.length];
        for(int i=0;i<matrix.length;i++){
            arr[i]=matrix[i][matrix[0].length-1];
        }

        int low=0,high=arr.length-1,res=arr.length;
        while(low<=high){
            int mid=low+(high-low)/2;

            if(arr[mid]>=target){
                res=mid;
                high=mid-1;
            }
            else
                low=mid+1;
        }

        if(res==arr.length){
            System.out.print("-1");
        }
        else{
            int left=0,right=matrix[res].length-1;String ans="-1";
            while(left<=right){
                int mid=left+(right-left)/2;
            
                if(matrix[res][mid]==target){
                    ans=res+" "+mid;
                    break;
                }
                else if(matrix[res][mid]<target)
                    left=mid+1;
                else
                    right=mid-1;
            }
        System.out.print(ans);
    }
        }
        
}

