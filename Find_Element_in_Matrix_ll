class Find {
    public static void main(String[] args) {
        int matrix[][]={
            {1,4,7,11,15},
            {2,5,8,12,19},
            {3,6,9,16,22},
            {10,13,14,17,24},
            {18,21,23,26,30}
        };
        int row=0,col=matrix[0].length-1,target=18;
        String res="-1";
        while(row<matrix.length && col>-1){
            if(matrix[row][col]==target){
                res=row+" "+col;
                break;
            }
            else if(matrix[row][col]<target)
                row++;
            else
                col--;
        }
        System.out.print(res);
    }  
}
