class Solution {
    public int equalSubstring(String s, String t, int maxCost) {
        int n=s.length();
        int left=0, j=0, currCost=0;
        int len=0;

        while(j<n){
            currCost+=Math.abs(s.charAt(j)-t.charAt(j));
            while(currCost>maxCost)
            {
                currCost-=Math.abs(s.charAt(left)-t.charAt(left));
                left++;
            }
            len=Math.max(len, j-left+1);
            j++;
        }
        return len;
    }
}
