class Solution {
    public int solve(int[] nums, int i,int[] arr){
        if(i>=nums.length)
            return 0;
        
        if(arr[i]!=-1){
            return arr[i];
        }
        else{
            int Pick=nums[i]+solve(nums, i+2,arr);
            int non_Pick=solve(nums,i+1,arr);

            arr[i]=Math.max(Pick,non_Pick); 
            return arr[i];
        }
    }
    public int rob(int[] nums) {
        int i=0;
        int[] arr=new int[nums.length];
        for(int j=0;j<arr.length;j++){
            arr[j]=-1;
        }
        int Pick=nums[i]+solve(nums, i+2,arr);
        int non_Pick=solve(nums,i+1,arr);

        return Math.max(Pick,non_Pick);
    }
}
