------------------------------Better Approach---------------------
better approach steps
1. Calculate both list lengths.
2. Find the difference between their lengths.
3. Move the longer list's pointer forward by that difference.
4. Move both pointers together until t1 == t2.
5. Return t1.
---------------------------Optimal-----------------------
/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
public class Solution {
    public ListNode getIntersectionNode(ListNode headA, ListNode headB) {
        ListNode t1=headA;
        ListNode t2=headB;

        if(headA==null && headB==null)
            return null;

        while(t1!=t2){
            if(t1==null){
                t1=headB;
            }
            else{
                t1=t1.next;
            }
            
            if(t2==null){
                t2=headA;
            }
            else{
                t2=t2.next;
            }
        }
        return t1;
    }
}
