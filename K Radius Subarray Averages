class Solution {
    public int[] getAverages(int[] nums, int k) {
        int [] res=new int[nums.length];
        long sum=0;
        int len=(2*k)+1;
        for(int i=0;i<nums.length;i++){
                res[i]=-1;
            }
        if(len>nums.length)
            return res;

        for(int i=0;i<len;i++){
            sum+=nums[i];
        }

        res[k]=(int)(sum/len);

        for(int i=k+1;i<nums.length-k;i++){
            sum-=nums[i-k-1];
            sum+=nums[i+k];

            res[i]=(int)(sum/len);
        }

        return res;
    }
}
