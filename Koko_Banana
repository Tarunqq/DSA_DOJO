class Koko_Banana {
    public static void main(String[] args) {
        int[] arr={3,6,7,11};
        int h=8,res=0;
        int max=Integer.MIN_VALUE;
        
        for(int i=0;i<arr.length;i++){
            if(arr[i]>max)
                max=arr[i];
        }

        int low=1,high=max;

        while(low<=high){
            int mid=low+(high-low)/2;
            int hrs=0;
            for(int i=0;i<arr.length;i++){
                hrs=hrs+(arr[i]/mid);
                if(arr[i]%mid!=0)
                    hrs++;
            }

            if(hrs<=h){
                res=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        System.out.print(res);
    }
}
