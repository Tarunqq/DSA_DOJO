--------------------------------Better-------------------------------------------
class Solution {
    public void inOrder(TreeNode root,List<Integer> ls){
        if(root==null)
            return;
        
        inOrder(root.left,ls);
        ls.add(root.val);
        inOrder(root.right,ls);
    }
    public int kthSmallest(TreeNode root, int k) {
        List<Integer> ls=new ArrayList<>();
        inOrder(root,ls);
        return ls.get(k-1);
    }
}
-------------------------Optimal----------------------------------------------------------
class Solution {
    public int kthSmallest(TreeNode root, int k) {
        Stack<TreeNode> st=new Stack<>();
        TreeNode curr=root;

        while(curr!=null || st!=null){
            while(curr!=null){
                st.add(curr);
                curr=curr.left;
            }
            curr=st.pop();
            k--;
            if(k==0)
                return curr.val;
            curr=curr.right;
        }
        return -1;
    }
}
