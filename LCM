    //[Approach -3] using the formula=> (a*b)=LCM * GCD to find LCM after find GCD(Euclidean algo)
    
    public static void main(String[] args) {
        int a=17, b=23;
        int ab=a*b;
        int GCD=1;
        while(b!=0){
            int rem=a%b;
            a=b;
            b=rem;
        }
        GCD=a;
        System.out.println("GCD: "+GCD);

        //formula=> (a*b)=LCM * GCD;
        //LCM= (a*b)/GCD;

        System.out.println("LCM: "+ab/GCD);

    }
