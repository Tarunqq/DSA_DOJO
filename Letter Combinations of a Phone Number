class Solution {
    public void solve(int idx, String digits, HashMap<Integer,String> map, String curr, List<String> res){
        if(idx==digits.length()){
            res.add(curr);
            return;
        }

        int digit=digits.charAt(idx)-'0';
        String ltrs=map.get(digit);

        for(int i=0;i<ltrs.length();i++){
            solve(idx+1,digits,map,curr+ltrs.charAt(i),res);
        }
    }
    public List<String> letterCombinations(String digits) {
        HashMap<Integer,String> map=new HashMap<>();
        map.put(2,"abc");
        map.put(3,"def");
        map.put(4,"ghi");
        map.put(5,"jkl");
        map.put(6,"mno");
        map.put(7,"pqrs");
        map.put(8,"tuv");
        map.put(9,"wxyz");

        List<String> res=new ArrayList<>();
        solve(0,digits,map,"",res);

        return res;
    }
}
