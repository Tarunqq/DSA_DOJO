--------------------------------------------[Optimal]-------------------------------------------
class Solution {
    public int longestConsecutive(int[] nums) {
        HashSet<Integer> Set=new HashSet<>();

        if (nums.length == 0)
            return 0;
        
        for(int num:nums){
            Set.add(num);
        }
        int bestCount=0;
        for(int num:Set){
            if(!Set.contains(num-1))  {
                int count=1;
                while(Set.contains(num+1)){
                    count++;
                    num++;
                }
                bestCount=Math.max(count,bestCount);
            }
       }
        return bestCount;
    }
    
}
-------------------------------[better]--------------------
class Solution {
    public int longestConsecutive(int[] nums) {
        Arrays.sort(nums);

        if(nums.length==0)
            return 0;
        
        int bestCount=1, leastNum=Integer.MIN_VALUE,count=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==leastNum+1){
                count++;
                leastNum=nums[i];
            }
            else if(nums[i]!=leastNum){
                count=1;
                leastNum=nums[i];
            }
            bestCount=Math.max(count,bestCount);
        }
        return bestCount;
    }
    
}
