//Optimal Approach(Kadane's algorithm)
class Max_SubArray {
    public static void main(String[] args) {
        int arr[]={1,2,1,-4,3,4,5,-3,1,-4,-7};
   
        int maxSum=Integer.MIN_VALUE,sum=0;
        int start=0,mSt=0,mEnd=0;
        for(int i=0;i<arr.length;i++){
            sum=sum+arr[i];
            if(sum>maxSum){
                maxSum=sum;
                mSt=start;
                mEnd=i;
            }
            if(sum<0){
                sum=0;
                start=i+1;
            }
        }
        System.out.println(maxSum);
        System.out.println("start: "+mSt+" End: "+mEnd);
}
