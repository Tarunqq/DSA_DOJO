class Solution {
    public double findMaxAverage(int[] nums, int k) {
        int sum=0;
        int best=Integer.MIN_VALUE;

        // for(int i=0;i<k;i++){
        //     sum+=nums[i];
        // }
        // best=Math.max(sum,best);

        // for(int j=k;j<nums.length;j++){
        //     sum+=nums[j]-nums[j-k];
        //     best=Math.max(sum,best);
        // }

        for(int i=0;i<nums.length;i++){
            sum+=nums[i];
            if(i>=k)
                sum-=nums[i-k];
            if(i>=k-1)
                best=Math.max(best,sum);
        }
        return (double)best/k;
    }
}
