class MinStack {
    Stack<int[]> st=new Stack<>();

    public MinStack() {
        
    }
    
    public void push(int value) {
        int mini=st.empty() ? value :Math.min(st.peek()[1], value);
        st.push(new int[]{value, mini});
    }
    
    public void pop() {
        st.pop();
    }
    
    public int top() {
        return st.peek()[0];
    }
    
    public int getMin() {
        return st.peek()[1];
    }
}
