class Solution {
    public int findMin(int[] nums) {
        int[] arr=nums;
        int min=Integer.MAX_VALUE;

        int low=0,high=arr.length-1;

        while(low<=high){
            int mid=low+(high-low)/2;

            if(arr[low]<=arr[mid]){
                if(arr[low]<min){
                    min=arr[low];
                }
                low=mid+1;
            }
            else{
                    if(arr[mid]<min){
                        min=arr[mid];
                    }
                    high=mid-1;
            }
        }
        return min;
    }
}
