class Solution {
    public int[] nextGreaterElements(int[] nums) {
        Stack<Integer> st=new Stack<>();
        int[] res=new int[nums.length];
        int n=nums.length;

        for(int i=2*n-1;i>=0;i--){
                int ind=i%n;
                while(!(st.empty()) && nums[ind]>=st.peek()){
                    st.pop();
                }

                if(i<n){
                    res[i]=st.empty()?-1:st.peek();
                }

                st.push(nums[ind]);
        }
        return res;   
    }
}
