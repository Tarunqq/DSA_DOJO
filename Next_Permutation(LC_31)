class Solution {
    public int[] rev(int[] arr, int left, int right){
        while(left<=right){
            int temp=arr[left];
            arr[left]=arr[right];
            arr[right]=temp;

            left++;
            right--;
        }

        return arr;
    }
    public void nextPermutation(int[] nums) {
        int index=-1;

        for(int i=nums.length-2;i>=0;i--)
        {
            if(nums[i]<nums[i+1]){
                index=i;
                break;
            }
        }

        if(index==-1)
        {
            rev(nums,0,nums.length-1);
            return;
        }

        int lg=Integer.MAX_VALUE,lg_ind=-1;
        // for(int j=index+1;j<nums.length;j++){
        //     if(nums[j]>nums[index] && nums[j]<lg){
        //         lg=nums[j];
        //         lg_ind=j;
        //     }
        // }

        for(int j=nums.length-1;j>=index+1;j--){
            if(nums[j]>nums[index] && nums[j]<lg){
                lg=nums[j];
                lg_ind=j;
            }
        }

        int temp=nums[index];
        nums[index]=nums[lg_ind];
        nums[lg_ind]=temp;

        rev(nums, index+1,nums.length-1);

    }
}
