class Solution {
    public int findNthDigit(int n) {
        long og=n;
        long count=9;
        long digits=0;
        long ps=0,num=0;
        String res="";
        char op=' ';
        
        while(true){
            digits++;
            if(og<=digits*(count)){
                long offset=(og-1)/digits;
                num=offset+(long)Math.pow(10,digits-1);
                ps=(og-1)%digits;

                res=Long.toString(num);
                op=res.charAt((int)ps);
                break;
            }
            og-=digits*(count);
            count*=10;
        }

        return (int)op-'0';
    }
}
