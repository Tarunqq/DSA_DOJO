[Approach 2]

class Concentric_square_pattern {
    public static void main(String[] args) {
        int n=4;
        int center=n-1;
        for(int i=0;i<2*(n)-1;i++){
            for(int j=0;j<2*(n)-1;j++){
                int dis=Math.max(Math.abs(i-center),Math.abs(j-center));
                System.out.print(1+dis+" ");
            }
            System.out.println();
        }
    }
}
