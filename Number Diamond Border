[Approach 1]
public class Concentric_square_pattern {
    public static void main(String[] args){
        int n=4;
        int size=(2*n)-1;

        for(int i=0;i<size;i++){
            for(int j=0;j<size;j++){
                int val=Math.min(Math.min(i, j),Math.min(size-1-i,size-1-j));
                System.out.print(n-val+" ");
            }
            System.out.println();
        }
    }
}
