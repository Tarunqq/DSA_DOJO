public class Number_Diamond {
    public static void main(String[] args){
        int n=4;
        for(int i=1;i<=n;i++){
            int Count=1;
            for(int j=1;j<=i;j++){
                System.out.print(Count+" ");
                Count++;
            }
            System.out.println();
        }

        for(int i=n-1;i>=1;i--){
            int Count=1;
            for(int j=1;j<=i;j++){
                System.out.print(Count+" ");
                Count++;
            }
            System.out.println();
        }
    }
}
