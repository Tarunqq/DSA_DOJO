public class Number_Grid_with_Separator {
    public static void main(String[] args) {
        int Count=1,n=4;
        for(int i=1;i<=n;i++){
            for(int j=1;j<=n;j++){
                System.out.print(Count);
                if(j!=n){
                    System.out.print("*");
                }
                Count++;
            }
            System.out.println();
        }
    }
}
