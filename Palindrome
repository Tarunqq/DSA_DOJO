public class Palindrome {
    public static void main(String[] args) {
        int n=2103012;
        int new_n=n;
        int rev=0;
        while(n>0){
            rev=rev*10+n%10;
            n=n/10;
        }
        if(new_n==rev)
            System.out.println("Palindrome");
        else
            System.out.println("Not a palindrome");
    }
}
