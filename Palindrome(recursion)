class Main {
    public static boolean palindrome(String s,int i, int j){
        if(i>=j)
            return true;

        if(s.charAt(i)!=s.charAt(j)){
            return false;
        }
        else{
            return palindrome(s,i+1,j-1);
        }
    }
    public static void main(String[] args) {
        String s="racecar";

        System.out.print(palindrome(s,0,s.length()-1));
    }
}
