[Approach2]

class Pascal_Triangle {
    public static void main(String[] args) {
            int n=6;
            int arr[][]= new int[n][n];
            for(int i=0;i<n;i++){
                for(int j=0;j<=i;j++){
                    if(j==0||j==i){
                        arr[i][j]=1;
                    }
                    else{
                        arr[i][j]=arr[i-1][j-1]+arr[i-1][j];
                    }
                }
            }
            for(int i=0;i<n;i++){
                for(int k=0;k<n-i-1;k++){
                    System.out.print(" ");
                }
                for(int j=0;j<=i;j++){
                    System.out.print(arr[i][j]+" ");
                }
                System.out.println();
            }
    }
}

