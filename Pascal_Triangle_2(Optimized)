class Pascal_Triangle {
    public static int NcR(int n,int r){
        int res=1;
        for(int i=0;i<r;i++){
            res=res*(n-i);
            res=res/(i+1);
        }
        return res;
    }
    public static void main(String[] args) {
        int n=6;
        for(int i=0;i<n;i++){
            for(int k=0;k<n-i-1;k++){
                System.out.print(" ");
            }
            for(int j=0;j<=i;j++){
                System.out.print(NcR(i,j)+" ");
            }
            System.out.println();
        }
    }
}
