public class Perfect_number {
    public static void main(String[] args) {
        int n=12;
        int sum=1;
        for(int i=2;i*i<=n;i++){
            if(n%i==0){
                sum+=i;
                if(i!=n/i){
                    sum+=n/i;
                    
                }
            }
            
        }
        System.out.println("Sum: "+sum);
        if(sum==n){
            System.out.println("perfect number");
        }
        else{
            System.out.println("Not a Perfect number");
        }
    }
}
