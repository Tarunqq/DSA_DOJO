//Leetcode - 78

class Solution {
    public void solve(int i,List<Integer> curr,int[] arr,int n, List<List<Integer>> res){
        if(i==n){
            res.add(new ArrayList<>(curr));
            return;
        }
        curr.add(arr[i]);
        solve(i+1, curr, arr,n, res);
        curr.remove(curr.size()-1);
        solve(i+1, curr, arr,n, res);
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> res=new ArrayList<>();
        solve(0, new ArrayList<>(), nums, nums.length, res);
        return res;
    }
}

