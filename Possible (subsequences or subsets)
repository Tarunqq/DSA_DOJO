import java.util.*;
class Main {
    public static void solve(int i, List<Integer> curr,int[] arr, int n)
    {
        if(i==n){
            System.out.println(curr);
            return;
        }
        curr.add(arr[i]);
        solve(i+1,curr,arr,n);
        curr.remove(curr.size()-1);
        solve(i+1,curr,arr,n);
    }
    public static void main(String[] args) {
        int[] arr={4,5,8,9};
        solve(0,new ArrayList<>(), arr,arr.length);
    }
}

