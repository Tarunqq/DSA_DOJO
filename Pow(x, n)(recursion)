//LeetCode - 50
class Solution {
    public double mul(double x, long n){
        if(n==0)
            return 1;
        if(n<0)
            return 1/mul(x,-n);

        if(n%2==0)
            return mul(x*x,n/2);
        else
            return x * mul(x*x,n/2);
    }
    public double myPow(double x, int n) {
        return mul(x,(long)n);
    }
}
