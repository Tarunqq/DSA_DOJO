package Patterns;

public class Prime_number {
    public static void main(String[] args) {
        int n=41;
        boolean b=true;
        for(int i=2;i*i<=n;i++){
            if(n%i==0){
                b=false;
                break;
            }
        }

        if(b){
            System.out.println("Prime");
        }
        else{
            System.out.println("Not Prime");
        }
    }
}
