import java.util.*;
class Rev_String {
    public static void main(String[] args) {
        String str=" Hello World ";
        ArrayList<String> list=new ArrayList<>();
        String word="";

        for(int i=0;i<str.length();i++){
            if(str.charAt(i)==' '){
                if(word.length()!=0)
                    list.add(word);
                word="";
            }
            else{
                word+=str.charAt(i);
            }
        }
        if(word.length()!=0)
            list.add(word);
        int st=0,end=list.size()-1;
        while(st<end){
            String temp=list.get(st);
            list.set(st,list.get(end));
            list.set(end,temp);

            st++;
            end--;
        }

        String res="";
        for(int i=0;i<list.size();i++){
            if(i!=0){
                res+=" ";
            }
            res+=list.get(i);
        }
        System.out.print(res);
    }
}
