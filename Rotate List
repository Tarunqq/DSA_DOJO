 * }
 */
class Solution {
    public ListNode rotateRight(ListNode head, int k) {
        ListNode temp=head;
        ListNode temp2=head;
        int cnt=0;
        if(head==null || head.next==null){
            return head;
        }
        while(temp2!=null){
            cnt++;
            temp2=temp2.next;
        }
        
        k=k%cnt;
        while(k>0){
            while(temp.next.next!=null){
                temp=temp.next;
            }
            ListNode sh=temp.next;
            temp.next=null;
            sh.next=head;
            head=sh;
            temp=head;
            k--;
        }

