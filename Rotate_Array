[Rotate Array- Anti-ClockWise]

class Rotate_Array {
    public static int[] rev(int arr[],int a,int b){
        int i=a,j=b;
        while(i<j){
            int temp=arr[i];
            arr[i]=arr[j];
            arr[j]=temp;
            i++;
            j--;
        }
        return arr;
    }
    public static void main(String[] args) {
        int arr[]={1,2,3,4,5,6,7};
        int k=3,n=arr.length-1;

        arr=rev(arr,0,n);//[7,6,5,4,3,2,1]
        arr=rev(arr,0,n-k);
        arr=rev(arr,k+1,n);

        for(int i=0;i<arr.length;i++){
            System.out.print(arr[i]+" ");
        }

    }
}
