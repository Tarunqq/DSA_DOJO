class Solution {
    public int[][] markRow(int[][] matrix, int i,int m){
        for(int j=0;j<m;j++){
            if(matrix[i][j]!=0)
                matrix[i][j]=-1;
        }
        return matrix;
    }

    public int[][] markCol(int[][] matrix, int j,int n){
        for(int i=0;i<n;i++){
            if(matrix[i][j]!=0)
                matrix[i][j]=-1;
        }
        return matrix;
    }

    public void setZeroes(int[][] matrix) {
        for(int i=0;i<matrix.length;i++){
            for(int j=0;j<matrix[0].length;j++){
                if(matrix[i][j]==0){
                    matrix=markRow(matrix,i,matrix[0].length);
                    matrix=markCol(matrix,j,matrix.length);
                }
            }
        }
        
        for(int i=0;i<matrix.length;i++){
            for(int j=0;j<matrix[0].length;j++){
                if(matrix[i][j]==-1)
                    matrix[i][j]=0;
            }
        }
    }
}

