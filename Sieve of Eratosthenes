class Prime_Number {
    public static void main(String[] args) {
        int n = 100, size = n + 1;
        boolean Primes[] = new boolean[size];

        for (int i = 0; i <= n; i++) {
            Primes[i] = true;
        }

        for (int i = 2; i * i <= n; i++) {
            if (Primes[i] != false) {
                for (int j = i * i; j <= n; j = j + i) {
                    Primes[j] = false;
                }
            }
        }

        for (int i = 2; i <= n; i++) {
            System.out.print(Primes[i] == true ? i + " " : "");
        }
    }
}
