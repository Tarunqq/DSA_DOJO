class Single_number {
    public int[] singleNumber(int[] nums) {
        int x=0;
        
        for(int i=0;i<nums.length;i++){
            x=x^nums[i];
        }
        int a=1;
        while(x>=a){
            if((x&a)>0)
                break;
            a=a<<1;
        }
        int y=0;
        for(int i=0;i<nums.length;i++){
            if((a&nums[i])>0)
                y=y^nums[i];
        }
        int arr[]={x^y,y};
        return arr;
    }
}
