class Single_number {
    public int singleNumber(int[] nums) {
        int max=Integer.MIN_VALUE,res=0,x=1;

        for(int i=0;i<nums.length;i++){
            if(nums[i]>max)
                max=nums[i];
        }

        while(max>=x){
            int count=0;
            for(int i=0;i<nums.length;i++){
                if((nums[i]&x)>0)
                    count++;
            }
            if(count%3==1)
                res|=x;
            
            x=x<<1;
        }
        return res;
    }
}
