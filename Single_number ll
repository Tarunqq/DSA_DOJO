_______for negative values & positive values in array__________________

class Solution {
    public int singleNumber(int[] nums) {
        int max=Integer.MIN_VALUE,res=0,x=1;

        for(int i=0;i<32;i++){
            
                int count=0;
                for(int j=0;j<nums.length;j++){
                    if((nums[j]&x)!=0)
                        count++;
                }
                if(count%3==1)
                    res|=x;
                
                x=x<<1;
            }
            return res;
        }

    }

