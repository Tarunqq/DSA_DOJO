/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
class Solution {
    public ListNode mid(ListNode head){
        ListNode slow=head;
        ListNode fast=head.next.next;

        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
        }
        return slow;
    }
    public ListNode mergeTwoLists(ListNode low, ListNode right){
        ListNode dummy=new ListNode(0);
        ListNode curr=dummy;
        while(low!=null && right!=null){
            if(low.val<right.val){
                ListNode next=low.next;
                curr.next=low;
                low=next;
            }
            else{
                ListNode next=right.next;
                curr.next=right;
                right=next;
            }
            curr=curr.next;
        }
        if(low!=null)
            curr.next=low;
        if(right!=null)
            curr.next=right;

        return dummy.next;
    }
    public ListNode sort(ListNode head){
        if(head==null || head.next==null)
            return head;
        ListNode mid=mid(head);
        ListNode low=head;
        ListNode right=mid.next;
        mid.next=null;

        ListNode first=sort(low);
        ListNode last=sort(right);

        ListNode merge=mergeTwoLists(first, last);

        return merge;

    }
    public ListNode sortList(ListNode head) {
        return sort(head);
        
    }
}
