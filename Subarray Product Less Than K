class Solution {
    public int numSubarrayProductLessThanK(int[] nums, int k) {
        int left=0,prod=1,count=0;
        for(int i=0;i<nums.length;i++){
            prod*=nums[i];
            while(prod>=k && left<=i){
                prod=prod/nums[left];
                left++;
            }
            count+=i-left+1;
        }
        return count;
    }
}
