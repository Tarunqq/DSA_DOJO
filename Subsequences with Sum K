-----------------------print all subsets with sum == k----------------------------------------
import java.util.*;
public class MainClass {
    static int k = 3;

    public static void solve(int i, List<Integer> curr, int sum, int[] arr, int n) {
        if (i == n) {
            if (sum == k) {
                System.out.println(curr);
            }
            return;
        }

        // Include the current element
        curr.add(arr[i]);
        solve(i + 1, curr, sum + arr[i], arr, n);

        // Backtrack: remove the current element
        curr.remove(curr.size() - 1);

        // Exclude the current element
        solve(i + 1, curr, sum, arr, n);
    }

    public static void main(String[] args) {
        int[] arr = {0, 1, 2};
        int sum = 0;

        solve(0, new ArrayList<>(), sum, arr, arr.length);
    }
}

