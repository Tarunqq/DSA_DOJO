class Solution {
    int[] arr=new int[26];
    PriorityQueue<Integer> pq=new PriorityQueue<>(Collections.reverseOrder());

    public int leastInterval(char[] tasks, int n) {
        for(int i=0;i<tasks.length;i++){
            arr[tasks[i]-'A']++;
        }

        for(int i=0;i<arr.length;i++){
            if(arr[i]>0)
                pq.add(arr[i]);
        }

        int time=0;
        while(!pq.isEmpty()){
            List<Integer> ls=new ArrayList<>();
            for(int i=1;i<=n+1;i++){
                if(!pq.isEmpty()){
                    int freq=pq.peek();
                    pq.poll();
                    freq--;
                    ls.add(freq);
                }
            }
                for(int num:ls)
                    if(num>0)
                        pq.add(num);
                
                if(pq.isEmpty())
                    time+=ls.size();
                else
                    time+=n+1;
               
        }
        return time;
    }
}
