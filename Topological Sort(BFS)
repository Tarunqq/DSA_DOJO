import java.util.*;
class Main {
    static class Edge {
        int src;
        int dest;
        int wt;

        public Edge(int s, int d, int w) {
            this.src = s;
            this.dest = d;
            this.wt = w;
        }
    }
    public static void createGraph(ArrayList<Edge>[] graph){
        for (int i = 0; i < graph.length; i++) {
            graph[i] = new ArrayList<>();
        }

        graph[2].add(new Edge(2,3,1));

        graph[3].add(new Edge(3,1,1));

        graph[4].add(new Edge(4,0,1));
        graph[4].add(new Edge(4,1,1));

        graph[5].add(new Edge(5,0,1));
        graph[5].add(new Edge(5,2,1));
        
    }
    public static void inOrd(ArrayList<Edge>[] graph, int[] inOrdArr){
        for(int i=0;i<graph.length;i++){
            for(int j=0;j<graph[i].size();j++){
                Edge e=graph[i].get(j);
                inOrdArr[e.dest]++;
            }
        }
    }
    public static void TopoSortBFS(ArrayList<Edge>[] graph){
        int[] inOrdArr=new int[graph.length];
        inOrd(graph,inOrdArr);

        Deque<Integer> dq=new ArrayDeque<>();
        for(int i=0;i<inOrdArr.length;i++){
            if(inOrdArr[i]==0)
                dq.offer(i);
        }

        while(!dq.isEmpty()){
            int curr=dq.poll();
            System.out.print(curr+" ");
            for(int i=0;i<graph[curr].size();i++){
                Edge e=graph[curr].get(i);
                inOrdArr[e.dest]--;
                if(inOrdArr[e.dest]==0)
                    dq.offer(e.dest);
            }
        }
    }
    public static void main(String[] args) {
        int V = 6;
        ArrayList<Edge>[] graph = new ArrayList[V];
        createGraph(graph);
        TopoSortBFS(graph);
    }
}
