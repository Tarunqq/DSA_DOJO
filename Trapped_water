//Using monotonic stack
class Solution {
    public int trap(int[] height) {
        Stack<Integer> st=new Stack<>();

        int left[]=new int[height.length];
        int right[]=new int[height.length];
        int sum=0;

        for(int i=0;i<height.length;i++){
            while(!st.empty() && st.peek()<=height[i])
                st.pop();

            if(st.empty())
                left[i]=0;
            else
                left[i]=st.peek();

            if(st.empty())
                st.push(height[i]);
            else if(st.peek()>height[i])
                left[i]=st.peek();
        }

        st.clear();

        for(int i=height.length-1;i>=0;i--){
            while(!st.empty() && st.peek()<=height[i])
                st.pop();

            if(st.empty())
                right[i]=0;
            else
                right[i]=st.peek();

            if(st.empty())
                st.push(height[i]);
            else if(st.peek()>height[i])
                right[i]=st.peek();
        }

        for(int i=0;i<height.length;i++){
            if((left[i]==0 || right[i]==0))
                continue;
            else
                sum+=Math.min(left[i],right[i])-height[i];
        }
        return sum;
    }
}
