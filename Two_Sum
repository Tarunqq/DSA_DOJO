class Solution {
    public int[] twoSum(int[] nums, int target) {
        int count[]=new int[2];

        HashMap<Integer,Integer> map=new HashMap<>();

        for(int i=0;i<nums.length;i++){
            map.put(nums[i],i);
        }

        for(int i=0;i<nums.length;i++){
            if(map.containsKey(target-nums[i])){
                count[0]=i;
                count[1]=map.getOrDefault(target-nums[i],-1);
                
                if(count[0]!=count[1])
                    return count;
            }
        }

        return count;
    }
}
