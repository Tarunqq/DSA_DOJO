class Solution {
    public int findPath(int r, int c, int m,int n){
        if(r==m-1 && c==n-1)
            return 1;
        
        if(r>=m || c>=n)
            return 0;

        return findPath(r+1, c, m,n)+findPath(r,c+1, m,n);
    }
    public int uniquePaths(int m, int n) {
        return findPath(0, 0,m,n);
    }
}
------------------------Optimal(DP)----------------------------------
class Solution {
    public int findPath(int r, int c, int m,int n, int[][] matrix){
        if(r>=m || c>=n)
            return 0;
            
        if(matrix[r][c]!=-1)
            return matrix[r][c];
    
        if(r==m-1 && c==n-1)
            return 1;

        matrix[r][c]=findPath(r+1, c, m,n, matrix)+findPath(r,c+1, m,n,matrix);
        return matrix[r][c];
    }
    public int uniquePaths(int m, int n) {
        int[][] matrix=new int[m][n];
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                matrix[i][j]=-1;
            }
        }
        return findPath(0, 0,m,n,matrix);
    }
}
