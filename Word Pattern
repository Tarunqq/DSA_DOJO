class Solution {
    public boolean wordPattern(String pattern, String s) {
        HashMap<Character, String> map=new HashMap<>();
        String[] st=s.split(" ");

        if(pattern.length()!=st.length)
            return false;

        for(int i=0;i<pattern.length();i++){
            char p_ch=pattern.charAt(i);
            
            if(!map.containsKey(p_ch)){
                if(!map.containsValue(st[i]))
                    map.put(p_ch,st[i]);
                else
                    return false;
            }
            else{
                if(!map.get(p_ch).equals(st[i]))
                    return false;
            }
        }
        return true;
    }
}
